# OpenAI Configuration
VITE_OPENAI_API_KEY=your_openai_api_key_here

# SerpAPI Configuration (for competitor analysis)
VITE_SERPAPI_KEY=your_serpapi_key_here

# Instructions:
# 1. Copy this file to .env
# 2. Replace 'your_openai_api_key_here' with your actual OpenAI API key from: https://platform.openai.com/api-keys
# 3. Replace 'your_serpapi_key_here' with your actual SerpAPI key from: https://serpapi.com/dashboard